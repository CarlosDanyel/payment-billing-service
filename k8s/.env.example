# Configurações de Banco de Dados MySQL (payment-billing-service)
DB_HOST=mysql-payment
DB_PORT=3306
DB_NAME=payment_db
DB_USERNAME=oficina_user
DB_PASSWORD=oficina_pass
MYSQL_ROOT_PASSWORD=root_password
MYSQL_SO_PASSWORD=oficina_pass

# Configurações de Mensageria (RabbitMQ)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Configurações do Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-TOKEN
MERCADO_PAGO_NOTIFICATION_URL=https://api.oficina.com/api/payments/webhook

# Configurações Gerais
PORT=8081
APP_BASE_URL=https://api.oficina.com
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
LOGGING_LEVEL_COM_FIAP=INFO